    "st": cmd_status,
    "info": cmd_status,
    "monitor": cmd_monitor,
    "daemon": cmd_daemon,
    "install": install,
}


def main(argv):
    # Piped into the interpreter (`curl ... | python3`) there is no backing
    # file to run from, so the only sensible thing to do is self-install.
    main_file = getattr(sys.modules["__main__"], "__file__", None)
    if main_file is None or not os.path.exists(main_file):
        return install()

    if not argv:
        return cmd_list([])
    if argv[0] in ("-h", "--help", "help"):
        print(HELP)
        return 0
    if argv[0] in ("-v", "--version", "version"):
        print(f"toxic {VERSION}")
        return 0
    cmd, rest = argv[0], argv[1:]
    if cmd not in COMMANDS:
        die(f"unknown command: {cmd}\nrun `toxic help`")
    return COMMANDS[cmd](rest) or 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:
        os._exit(0)
